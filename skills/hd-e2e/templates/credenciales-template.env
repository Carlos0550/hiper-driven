# .hd/e2e/credenciales.env — lo completa el humano. Va git-ignored.
# Un bloque por rol. hd-e2e verifica que cada cuenta exista y tenga el rol que declara;
# si falta, la crea por seeds o por la base LOCAL (nunca remota, nunca producción).

HD_E2E_ADMIN_EMAIL=
HD_E2E_ADMIN_PASSWORD=
HD_E2E_ADMIN_ROLE=admin

HD_E2E_USER_EMAIL=
HD_E2E_USER_PASSWORD=
HD_E2E_USER_ROLE=usuario

# HD_E2E_STAFF_EMAIL=
# HD_E2E_STAFF_PASSWORD=
# HD_E2E_STAFF_ROLE=staff

# 2FA, si la app lo exige: seed TOTP o el bypass de desarrollo documentado en el app-map.
# HD_E2E_ADMIN_TOTP_SEED=

# Terceros: el modo se declara acá y se verifica contra el servicio. No se adivina.
# HD_E2E_STRIPE_KEY=sk_test_...
# HD_E2E_STRIPE_MODE=sandbox
